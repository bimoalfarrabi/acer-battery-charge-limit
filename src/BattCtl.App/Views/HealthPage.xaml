<Page
    x:Class="BattCtl.App.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodySecondaryTextBlockStyle}" />
        <Style x:Key="DetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Battery health" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="UpdatedCaption" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                </StackPanel>
                <ProgressRing HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Width="16" Height="16"
                              IsIndeterminate="True"
                              Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <StackPanel Spacing="20"
                        Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Capacity and wear -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Design capacity" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="DesignValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Full charge capacity" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="FullValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Wear" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="WearValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <ProgressBar Maximum="100"
                                     Margin="0,6,0,0"
                                     Value="{x:Bind ViewModel.HealthValue, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.HasWear, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock x:Name="HealthSummary"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- Live readings -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Details" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid>
                            <TextBlock Text="State" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="StateValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Power source" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="PowerValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Cycle count" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="CycleValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Voltage" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="VoltageValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Charge rate" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="RateValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Remaining capacity" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="RemainingValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Estimated time" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="EstimatedValue" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- First-launch skeleton -->
            <StackPanel x:Name="SkeletonPanel"
                        Spacing="20"
                        Visibility="{x:Bind ViewModel.ShowSkeleton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Height="150" CornerRadius="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Border Height="240" CornerRadius="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="12"
                        HorizontalAlignment="Center"
                        Padding="0,48"
                        Visibility="{x:Bind ViewModel.ShowLoadError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE783;" FontSize="32" HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Can't reach the battery service"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="360" />
                <Button Content="Try again"
                        HorizontalAlignment="Center"
                        Click="TryAgain_Click" />
            </StackPanel>

            <InfoBar x:Name="RefreshInfoBar"
                     Severity="Error"
                     IsClosable="True"
                     Closed="RefreshInfoBar_Closed" />
        </StackPanel>
    </ScrollViewer>
</Page>
